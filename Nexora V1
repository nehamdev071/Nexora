'use client';

import { usePathname } from 'next/navigation';
import { useEffect, useState } from 'react';
import Link from 'next/link';

const ITENS = [
  { href: '/', rotulo: 'Inicio' },
  { href: '/nexi', rotulo: 'Nexi IA' },
  { href: '/arquivos', rotulo: 'Arquivos' },
  { href: '/calendario', rotulo: 'Calendario' },
  { href: '/boletim', rotulo: 'Boletim' },
  { href: '/configuracoes', rotulo: 'Ajustes' },
];

type Tema = 'claro' | 'escuro' | 'auto';

export function Menu() {
  const caminho = usePathname();
  const [aberto, setAberto] = useState(false);
  const [tema, setTema] = useState<Tema>('auto');

  useEffect(() => {
    try {
      const salvo = (localStorage.getItem('nexora:tema') as Tema) || 'auto';
      setTema(salvo);
    } catch {}
  }, []);

  useEffect(() => { setAberto(false); }, [caminho]);

  function aplicar(novo: Tema) {
    setTema(novo);
    const efetivo = novo === 'auto'
      ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'escuro' : 'claro')
      : novo;
    document.documentElement.dataset.tema = efetivo;
    try { localStorage.setItem('nexora:tema', novo); } catch {}
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', efetivo === 'escuro' ? '#0a0e17' : '#f7f8fb');
  }

  return (
    <header className="menu-topo">
      <div className="container menu-inner">
        <Link href="/" className="marca">
          <span className="marca-ponto" aria-hidden="true" />
          Nexora
        </Link>
        <nav>
          <ul className={aberto ? 'menu-lista aberto' : 'menu-lista'} id="menu-principal">
            {ITENS.map((i) => (
              <li key={i.href}>
                <Link href={i.href} aria-current={caminho === i.href ? 'page' : undefined}>{i.rotulo}</Link>
              </li>
            ))}
          </ul>
        </nav>
        <button type="button" className="icone-btn" onClick={() => aplicar(tema === 'escuro' ? 'claro' : 'escuro')} aria-label="Alternar tema">
          {tema === 'escuro' ? '\u2600' : '\u25D0'}
        </button>
        <button type="button" className="icone-btn menu-mobile-btn" onClick={() => setAberto((v) => !v)} aria-expanded={aberto} aria-controls="menu-principal" aria-label="Menu">
          {aberto ? '\u00D7' : '\u2261'}
        </button>
      </div>
    </header>
  );
}
