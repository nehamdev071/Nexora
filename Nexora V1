import Dexie, { type Table } from 'dexie';

export interface Atividade { id?: number; titulo: string; descricao?: string; prazo: string; concluidaEm?: string | null; criadoEm: string; }
export interface Disciplina { id?: number; nome: string; ordem: number; ativa: boolean; }
export interface Nota { id?: number; disciplinaId: number; unidade: 1 | 2 | 3; decimos: number; }
export interface Pasta { id?: number; nome: string; paiId?: number | null; criadoEm: string; }
export interface Arquivo { id?: number; pastaId?: number | null; nome: string; mimeType: string; tamanho: number; blob: Blob; criadoEm: string; }
export interface Trabalho { id?: number; pastaId?: number | null; titulo: string; conteudo: string; versao: number; criadoEm: string; atualizadoEm: string; }
export interface Memoria { id?: number; chave: string; valor: string; criadoEm: string; }
export interface Config { chave: string; valor: unknown; }

class NexoraDB extends Dexie {
  atividades!: Table<Atividade, number>;
  disciplinas!: Table<Disciplina, number>;
  notas!: Table<Nota, number>;
  pastas!: Table<Pasta, number>;
  arquivos!: Table<Arquivo, number>;
  trabalhos!: Table<Trabalho, number>;
  memorias!: Table<Memoria, number>;
  config!: Table<Config, string>;
  constructor() {
    super('nexora');
    this.version(1).stores({
      atividades: '++id, prazo, concluidaEm',
      disciplinas: '++id, nome, ordem, ativa',
      notas: '++id, disciplinaId, [disciplinaId+unidade]',
      pastas: '++id, paiId, nome',
      arquivos: '++id, pastaId, criadoEm',
      trabalhos: '++id, pastaId, atualizadoEm',
      memorias: '++id, &chave',
      config: 'chave',
    });
  }
}

export const db = new NexoraDB();

export async function lerConfig<T>(chave: string, padrao: T): Promise<T> {
  const r = await db.config.get(chave);
  return r ? (r.valor as T) : padrao;
}
export async function gravarConfig(chave: string, valor: unknown): Promise<void> {
  await db.config.put({ chave, valor });
}

const DISCIPLINAS_PADRAO = [
  'Língua Portuguesa','Matemática','Química','Física','Biologia','Educação Física',
  'Geografia','História','Sociologia','Educação Sociocientífica','História da Bahia',
  'Educação Digital e Midiática','Linguagens e Culturas','Etnomatemática','Língua Inglesa','Artes',
] as const;

export async function garantirSeed(): Promise<void> {
  if (await db.config.get('seed:v1')) return;
  await db.transaction('rw', db.disciplinas, db.config, async () => {
    if ((await db.disciplinas.count()) === 0) {
      await db.disciplinas.bulkAdd(DISCIPLINAS_PADRAO.map((nome, ordem) => ({ nome, ordem, ativa: true })));
    }
    await db.config.put({ chave: 'seed:v1', valor: true });
  });
}

export async function listarPastas(paiId: number | null): Promise<Pasta[]> {
  if (paiId === null) {
    const todas = await db.pastas.toArray();
    return todas.filter((p) => p.paiId == null).sort((a, b) => a.nome.localeCompare(b.nome));
  }
  return (await db.pastas.where('paiId').equals(paiId).toArray()).sort((a, b) => a.nome.localeCompare(b.nome));
}

export async function excluirPastaRecursivo(pastaId: number): Promise<void> {
  await db.transaction('rw', db.pastas, db.arquivos, db.trabalhos, async () => {
    const filhas = await db.pastas.where('paiId').equals(pastaId).toArray();
    for (const f of filhas) if (f.id != null) await excluirPastaRecursivo(f.id);
    await db.arquivos.where('pastaId').equals(pastaId).delete();
    await db.trabalhos.where('pastaId').equals(pastaId).delete();
    await db.pastas.delete(pastaId);
  });
}
