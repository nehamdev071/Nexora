import { calcularStatus, ROTULO } from '@/lib/atividades';

const DIAS = ['D', 'S', 'T', 'Q', 'Q', 'S', 'S'];

export default function Calendario() {
  const [ref, setRef] = useState(() => { const d = new Date(); return new Date(d.getFullYear(), d.getMonth(), 1); });
  const [sel, setSel] = useState<string | null>(null);
  const [titulo, setTitulo] = useState('');
  const [prazo, setPrazo] = useState('');

  const atividades = useLiveQuery(() => db.atividades.toArray(), []) ?? [];

  const ano = ref.getFullYear();
  const mes = ref.getMonth();
  const primeiro = new Date(ano, mes, 1).getDay();
  const total = new Date(ano, mes + 1, 0).getDate();

  const celulas: (number | null)[] = [
    ...Array(primeiro).fill(null),
    ...Array.from({ length: total }, (_, i) => i + 1),
  ];

  const iso = (dia: number) => {
    const d = new Date(ano, mes, dia);
    return d.toISOString().slice(0, 10);
  };

  const doDia = (dia: number) => atividades.filter((a) => a.prazo.slice(0, 10) === iso(dia));

  async function criar() {
    if (!titulo.trim() || !prazo) return;
    await db.atividades.add({
      titulo: titulo.trim(),
      prazo: new Date(prazo).toISOString(),
      concluidaEm: null,
      criadoEm: new Date().toISOString(),
    });
    setTitulo(''); setPrazo('');
  }

  async function alternar(id: number, feito: boolean) {
    await db.atividades.update(id, { concluidaEm: feito ? null : new Date().toISOString() });
  }

  const listaSel = sel ? atividades.filter((a) => a.prazo.slice(0, 10) === sel) : [];

  return (
    <>
      <div className="card" style={{ marginBottom: 'var(--esp-4)' }}>
        <div className="card-titulo">
          <h2>{ref.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' })}</h2>
          <div style={{ display: 'flex', gap: 8 }}>
            <button className="icone-btn" onClick={() => setRef(new Date(ano, mes - 1, 1))} aria-label="Mes anterior">&#8249;</button>
            <button className="icone-btn" onClick={() => setRef(new Date(ano, mes + 1, 1))} aria-label="Proximo mes">&#8250;</button>
          </div>
        </div>
        <div className="cal-grade">
          {DIAS.map((d, i) => <div key={i} className="cal-cabecalho">{d}</div>)}
          {celulas.map((dia, i) => {
            if (dia === null) return <div key={'v' + i} />;
            const chave = iso(dia);
            const hoje = chave === new Date().toISOString().slice(0, 10);
            const tem = doDia(dia).length;
            const cls = ['cal-dia'];
            if (hoje) cls.push('hoje');
            if (sel === chave) cls.push('selecionado');
            return (
              <button key={chave} className={cls.join(' ')} onClick={() => setSel(sel === chave ? null : chave)}>
                {dia}
                {tem > 0 && <span className="ponto" />}
              </button>
            );
          })}
        </div>
      </div>

      {sel && (
        <div className="card" style={{ marginBottom: 'var(--esp-4)' }}>
