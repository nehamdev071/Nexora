import { PDFDocument, StandardFonts, rgb } from 'pdf-lib';

function quebrar(texto: string, max: number): string[] {
  const out: string[] = [];
  for (const p of texto.split('\n')) {
    if (!p.trim()) { out.push(''); continue; }
    let l = '';
    for (const w of p.split(' ')) {
      const t = l ? l + ' ' + w : w;
      if (t.length > max) { if (l) out.push(l); l = w; } else l = t;
    }
    if (l) out.push(l);
  }
  return out;
}

export async function gerarPdf(titulo: string, texto: string): Promise<Blob> {
  const doc = await PDFDocument.create();
  const f = await doc.embedFont(StandardFonts.Helvetica);
  const fB = await doc.embedFont(StandardFonts.HelveticaBold);
  const W = 595.28, H = 841.89, M = 56;
  const maxLinhas = Math.floor((H - M * 2 - 40) / 16);
  let pag = doc.addPage([W, H]);
  let y = H - M;
  pag.drawText(titulo.slice(0, 80), { x: M, y, size: 16, font: fB, color: rgb(0.06, 0.09, 0.16) });
  y -= 32;
  let c = 0;
  for (const l of quebrar(texto, 88)) {
    if (c >= maxLinhas) { pag = doc.addPage([W, H]); y = H - M; c = 0; }
    if (l) pag.drawText(l, { x: M, y, size: 11, font: f });
    y -= 16; c++;
  }
  return new Blob([(await doc.save()) as unknown as BlobPart], { type: 'application/pdf' });
}

export function baixarBlob(blob: Blob, nome: string) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = nome; a.click();
  URL.revokeObjectURL(url);
}
