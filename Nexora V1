export const UNIDADES = 3;
export const META_TOTAL = 15;
export const MAX_POR_UNIDADE = 10;

const fmt = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 1 });
export const pontosParaTexto = (p: number) => fmt.format(p);

export function pontosParaDecimos(pontos: number | null | undefined): number | null {
  if (pontos == null || Number.isNaN(pontos)) return null;
  if (pontos < 0 || pontos > MAX_POR_UNIDADE) throw new RangeError('Nota fora de 0-10');
  return Math.round(pontos * 10);
}

export type Situacao = 'sem_notas' | 'em_andamento' | 'meta_inalcancavel' | 'aprovado' | 'abaixo_da_meta';

export interface ResultadoDisciplina {
  decimos: (number | null)[];
  unidadesLancadas: number;
  unidadesRestantes: number;
  completo: boolean;
  totalPontos: number;
  maximoPossivelPontos: number;
  faltamPontos: number;
  excedentePontos: number;
  metaAtingida: boolean;
  situacao: Situacao;
  rotulo: string;
}

export function calcularDisciplina(entrada: (number | null | undefined)[]): ResultadoDisciplina {
  const decimos = Array.from({ length: UNIDADES }, (_, i) => {
    const v = entrada[i];
    if (v == null) return null;
    if (!Number.isInteger(v) || v < 0 || v > MAX_POR_UNIDADE * 10) throw new RangeError('Decimos invalidos');
    return v;
  });
  const lancadas = decimos.filter((d): d is number => d !== null);
  const totalDecimos = lancadas.reduce((a, b) => a + b, 0);
  const unidadesLancadas = lancadas.length;
  const unidadesRestantes = UNIDADES - unidadesLancadas;
  const completo = unidadesRestantes === 0;
  const totalPontos = totalDecimos / 10;
  const maximoPossivelPontos = (totalDecimos + unidadesRestantes * MAX_POR_UNIDADE * 10) / 10;
  const saldo = META_TOTAL * 10 - totalDecimos;
  const faltamPontos = saldo > 0 ? saldo / 10 : 0;
  const excedentePontos = saldo < 0 ? -saldo / 10 : 0;
  const metaAtingida = saldo <= 0;

  let situacao: Situacao;
  if (unidadesLancadas === 0) situacao = 'sem_notas';
  else if (!completo && maximoPossivelPontos < META_TOTAL) situacao = 'meta_inalcancavel';
  else if (!completo) situacao = 'em_andamento';
  else if (metaAtingida) situacao = 'aprovado';
  else situacao = 'abaixo_da_meta';

  let rotulo: string;
  if (unidadesLancadas === 0) rotulo = 'Sem notas';
  else if (saldo > 0) rotulo = 'Faltam ' + pontosParaTexto(faltamPontos) + ' pontos';
  else if (saldo === 0) rotulo = 'Meta atingida';
  else rotulo = '+' + pontosParaTexto(excedentePontos) + ' pontos alem da meta';

  return { decimos, unidadesLancadas, unidadesRestantes, completo, totalPontos, maximoPossivelPontos, faltamPontos, excedentePontos, metaAtingida, situacao, rotulo };
}

export async function salvarNota(disciplinaId: number, unidade: 1 | 2 | 3, pontos: number | null) {
  const { db } = await import('./db');
  const existente = await db.notas.where('[disciplinaId+unidade]').equals([disciplinaId, unidade]).first();
  if (pontos === null) {
    if (existente?.id != null) await db.notas.delete(existente.id);
    return;
  }
  const decimos = pontosParaDecimos(pontos)!;
  if (existente?.id != null) await db.notas.update(existente.id, { decimos });
  else await db.notas.add({ disciplinaId, unidade, decimos });
}
