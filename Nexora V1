'use client';
import { useEffect, useRef } from 'react';

export function FundoShader() {
  const ref = useRef<HTMLCanvasElement>(null);

  useEffect(() => {
    const canvas = ref.current;
    if (!canvas) return;
    const gl = canvas.getContext('webgl', { alpha: true, antialias: false, depth: false, powerPreference: 'low-power' });
    if (!gl) return;

    const vert = 'attribute vec2 a; void main(){ gl_Position=vec4(a,0.0,1.0); }';
    const frag = `
      precision mediump float;
      uniform vec2 r; uniform float t;
      float h(vec2 p){ return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
      float n(vec2 p){ vec2 i=floor(p),f=fract(p); vec2 u=f*f*(3.0-2.0*f);
        return mix(mix(h(i),h(i+vec2(1,0)),u.x),mix(h(i+vec2(0,1)),h(i+vec2(1,1)),u.x),u.y); }
      float fbm(vec2 p){ float v=0.0,a=0.5; for(int i=0;i<4;i++){ v+=a*n(p); p*=2.0; a*=0.5; } return v; }
      void main(){
        vec2 uv=gl_FragCoord.xy/r; float tt=t*0.05;
        float v=fbm(uv*3.0+vec2(tt,tt*0.7))+0.5*fbm(uv*5.1-vec2(tt*0.8,tt*1.1));
        v/=1.5;
        vec3 c=mix(vec3(0.26,0.22,0.79),vec3(0.05,0.65,0.64),smoothstep(0.25,0.85,v));
        float vin=smoothstep(1.15,0.25,length(uv-0.5)*1.6);
        gl_FragColor=vec4(c,0.16*vin*(0.55+0.45*v));
      }`;

    const comp = (tipo: number, src: string) => { const s = gl.createShader(tipo)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, comp(gl.VERTEX_SHADER, vert));
    gl.attachShader(prog, comp(gl.FRAGMENT_SHADER, frag));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1,3,-1,-1,3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uR = gl.getUniformLocation(prog, 'r');
    const uT = gl.getUniformLocation(prog, 't');

    function desenhar(tempo: number) {
      const prop = canvas!.clientHeight / Math.max(canvas!.clientWidth, 1) || 0.5;
      const w = 420, hh = Math.round(420 * prop);
      if (canvas!.width !== w || canvas!.height !== hh) {
        canvas!.width = w; canvas!.height = hh;
        gl!.viewport(0, 0, w, hh);
        gl!.uniform2f(uR, w, hh);
      }
      gl!.clearColor(0, 0, 0, 0);
      gl!.clear(gl!.COLOR_BUFFER_BIT);
      gl!.uniform1f(uT, tempo);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { desenhar(0); return; }

    let raf = 0;
    const inicio = performance.now();
    const laco = (agora: number) => { desenhar((agora - inicio) / 1000); raf = requestAnimationFrame(laco); };
    const aoVis = () => { if (document.hidden) cancelAnimationFrame(raf); else raf = requestAnimationFrame(laco); };
    document.addEventListener('visibilitychange', aoVis);
    raf = requestAnimationFrame(laco);

    return () => {
      cancelAnimationFrame(raf);
      document.removeEventListener('visibilitychange', aoVis);
      gl.getExtension('WEBGL_lose_context')?.loseContext();
    };
  }, []);

  return <canvas ref={ref} className="fundo-shader" aria-hidden="true" />;
}
