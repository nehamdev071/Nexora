import { db } from './db';

const VERSAO = 1;

function blobParaBase64(blob: Blob): Promise<string> {
  return new Promise((res, rej) => {
    const l = new FileReader();
    l.onload = () => res(String(l.result).split(',')[1] ?? '');
    l.onerror = () => rej(l.error);
    l.readAsDataURL(blob);
  });
}

function base64ParaBlob(b64: string, mime: string): Blob {
  const bin = atob(b64);
  const bytes = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
  return new Blob([bytes], { type: mime });
}

export async function exportarBackup(): Promise<void> {
  const [atividades, disciplinas, notas, pastas, trabalhos, memorias, config, arquivos] = await Promise.all([
    db.atividades.toArray(), db.disciplinas.toArray(), db.notas.toArray(), db.pastas.toArray(),
    db.trabalhos.toArray(), db.memorias.toArray(), db.config.toArray(), db.arquivos.toArray(),
  ]);
  const arq = await Promise.all(arquivos.map(async (a) => ({ ...a, blob: undefined, base64: await blobParaBase64(a.blob) })));
  const json = JSON.stringify({
    versao: VERSAO, geradoEm: new Date().toISOString(),
    tabelas: { atividades, disciplinas, notas, pastas, trabalhos, memorias, config, arquivos: arq },
  });
  const url = URL.createObjectURL(new Blob([json], { type: 'application/json' }));
  const a = document.createElement('a');
  a.href = url;
  a.download = 'nexora-backup-' + new Date().toISOString().slice(0, 10) + '.json';
  a.click();
  URL.revokeObjectURL(url);
}

export async function importarBackup(arquivo: File): Promise<void> {
  const dados = JSON.parse(await arquivo.text());
  if (dados?.versao !== VERSAO) throw new Error('Backup incompativel.');
  const t = dados.tabelas;
  const arquivos = await Promise.all(
    (t.arquivos as (Record<string, unknown> & { base64?: string; mimeType?: string })[]).map(
      async ({ base64, mimeType, ...resto }) => ({
        ...resto,
        mimeType: mimeType ?? 'application/octet-stream',
        blob: base64ParaBlob(base64 ?? '', mimeType ?? 'application/octet-stream'),
      })
    )
  );
  await db.transaction('rw', [db.atividades, db.disciplinas, db.notas, db.pastas, db.trabalhos, db.memorias, db.config, db.arquivos], async () => {
    await Promise.all([db.atividades.clear(), db.disciplinas.clear(), db.notas.clear(), db.pastas.clear(), db.trabalhos.clear(), db.memorias.clear(), db.config.clear(), db.arquivos.clear()]);
    await db.atividades.bulkAdd(t.atividades as never[]);
    await db.disciplinas.bulkAdd(t.disciplinas as never[]);
    await db.notas.bulkAdd(t.notas as never[]);
    await db.pastas.bulkAdd(t.pastas as never[]);
    await db.trabalhos.bulkAdd(t.trabalhos as never[]);
    await db.memorias.bulkAdd(t.memorias as never[]);
    await db.config.bulkAdd(t.config as never[]);
    await db.arquivos.bulkAdd(arquivos as never[]);
  });
}
