export const STATUS = {
  PENDENTE: 'pendente',
  EM_ATRASO: 'em_atraso',
  CONCLUIDA_NO_PRAZO: 'concluida_no_prazo',
  CONCLUIDA_COM_ATRASO: 'concluida_com_atraso',
} as const;

export type Status = (typeof STATUS)[keyof typeof STATUS];

export const ROTULO: Record<Status, string> = {
  pendente: 'Pendente',
  em_atraso: 'Em atraso',
  concluida_no_prazo: 'Concluida no prazo',
  concluida_com_atraso: 'Concluida com atraso',
};

export interface ComPrazo { prazo: string; concluidaEm?: string | null; }

export function calcularStatus(a: ComPrazo, agora: Date = new Date()): Status {
  const prazo = new Date(a.prazo);
  if (Number.isNaN(prazo.getTime())) throw new TypeError('Data invalida');
  if (!a.concluidaEm) return agora > prazo ? STATUS.EM_ATRASO : STATUS.PENDENTE;
  return new Date(a.concluidaEm) > prazo ? STATUS.CONCLUIDA_COM_ATRASO : STATUS.CONCLUIDA_NO_PRAZO;
}

export function proximasAtividades<T extends ComPrazo>(lista: T[], agora = new Date(), limite = 5): (T & { status: Status })[] {
  return lista
    .filter((a) => !a.concluidaEm)
    .map((a) => ({ ...a, status: calcularStatus(a, agora) }))
    .sort((x, y) => new Date(x.prazo).getTime() - new Date(y.prazo).getTime())
    .slice(0, limite);
}
